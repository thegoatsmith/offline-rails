{
  "name": "offline-rails",
  "version": "0.1.0",
  "private": true,
  "description": "A metro map you own. Pulls a city's rail network from OpenStreetMap once, then never touches the network again.",
  "type": "module",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "./node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-plugin-svelte": "0.0.6",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  }
}
