{
  "name": "offline-rails",
  "version": "0.1.0",
  "private": true,
  "description": "A metro map you own. Pulls a city's rail network from OpenStreetMap once, then never touches the network again.",
  "type": "module",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "./node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7",
    "bun-plugin-svelte": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "~6",
    "wrangler": "latest"
  }
}
